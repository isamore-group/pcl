set(SUBSYS_NAME global_tests)
set(SUBSYS_DESC "Point cloud library global unit tests")

PCL_SUBSYS_OPTION(build "${SUBSYS_NAME}" "${SUBSYS_DESC}" OFF)
PCL_SUBSYS_DEPEND(build NAME ${SUBSYS_NAME} DEPS ${SUBSYS_DEPS} OPT_DEPS ${OPT_DEPS})

if(NOT build)
  return()
endif()

find_package(GTestSource REQUIRED)
include_directories(SYSTEM ${GTEST_INCLUDE_DIRS} ${GTEST_SRC_DIR})

add_library(pcl_gtest STATIC ${GTEST_SRC_DIR}/src/gtest-all.cc)
target_include_directories(pcl_gtest PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)

enable_testing()

# VS needs -C config to run correct
if(MSVC)
  set(PCL_CTEST_ARGUMENTS ${PCL_CTEST_ARGUMENTS} -C $<$<CONFIG:Debug>:Debug>$<$<CONFIG:Release>:Release>)
endif()

# Enables you to disable visualization tests. Used on CI.
if(PCL_DISABLE_VISUALIZATION_TESTS)
  list(APPEND EXCLUDE_TESTS visualization)
endif()

# Enables you to disable GPU tests. Used on CI as it has no access to GPU hardware
if(PCL_DISABLE_GPU_TESTS)
  list(APPEND EXCLUDE_TESTS gpu)
endif()

#Check if there are any tests to exclude
if(EXCLUDE_TESTS)
  message(STATUS "Tests excluded: ${EXCLUDE_TESTS}")
  string(REPLACE ";" "|" EXCLUDE_TESTS_REGEX "${EXCLUDE_TESTS}")
  set(PCL_CTEST_ARGUMENTS ${PCL_CTEST_ARGUMENTS} -E "(${EXCLUDE_TESTS_REGEX})")
endif()

add_custom_target(tests "${CMAKE_CTEST_COMMAND}" ${PCL_CTEST_ARGUMENTS} -V -T Test VERBATIM)

set_target_properties(tests PROPERTIES FOLDER "Tests")

# ISAMORE LLVM IR generation for tests - Define functions/macros before subdirectories
if(PCL_ENABLE_LLVM_IR)
  # Set LLVM tool paths
  set(LLVM_LINK "/home/uvxiao/repos/jlm/build-llvm-mlir/bin/llvm-link")
  set(OPT "/home/uvxiao/repos/jlm/build-llvm-mlir/bin/opt")
  set(CLANG "/home/uvxiao/repos/jlm/build-llvm-mlir/bin/clang++")
  set(PASS_PATH "/home/uvxiao/profiler/build/lib/libbb_instrument.so")
  
  # Function to add LLVM IR generation for a test
  function(PCL_ADD_TEST_LLVM_IR name)
    # Skip fuzz, gpu, and visualization tests
    if(name MATCHES "fuzz|gpu|visualization")
      return()
    endif()
    
    # Extract test source - look in current directory and subdirectories
    # The test name format is like "common_test_common" where "common" is the subdirectory
    # and "test_common" is the actual executable name
    set(test_src "")
    
    # First try direct match
    foreach(subdir 2d common features filters geometry io kdtree keypoints ml people octree outofcore recognition registration search surface segmentation sample_consensus)
      if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${subdir}/${name}.cpp")
        set(test_src "${CMAKE_CURRENT_SOURCE_DIR}/${subdir}/${name}.cpp")
        break()
      endif()
    endforeach()
    
    # If not found, try to extract the real test name from the pattern
    if(NOT test_src)
      # Extract subdirectory and test name from patterns like "common_test_common"
      string(REGEX MATCH "^([^_]+)_(.+)$" _ ${name})
      if(CMAKE_MATCH_1 AND CMAKE_MATCH_2)
        set(subdir ${CMAKE_MATCH_1})
        set(test_file ${CMAKE_MATCH_2})
        
        # Check if the file exists in the subdirectory
        if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${subdir}/${test_file}.cpp")
          set(test_src "${CMAKE_CURRENT_SOURCE_DIR}/${subdir}/${test_file}.cpp")
        endif()
      endif()
    endif()
    
    if(NOT test_src)
      return()
    endif()
    
    # Create LLVM directory for tests
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/test/llvm")
    
    # Get include directories
    get_target_property(inc_dirs ${name} INCLUDE_DIRECTORIES)
    set(include_dirs "")
    foreach(inc ${inc_dirs})
      set(include_dirs "${include_dirs} -I${inc}")
    endforeach()
    # Add PCL includes
    set(include_dirs "${include_dirs} -I${PCL_SOURCE_DIR}/common/include")
    foreach(module ${PCL_MODULES_NAMES})
      if(EXISTS "${PCL_SOURCE_DIR}/${module}/include")
        set(include_dirs "${include_dirs} -I${PCL_SOURCE_DIR}/${module}/include")
      endif()
    endforeach()
    # Add test includes
    set(include_dirs "${include_dirs} -I${CMAKE_CURRENT_SOURCE_DIR}/include")
    set(include_dirs "${include_dirs} -I${GTEST_INCLUDE_DIRS}")
    
    # Add definitions
    set(definitions "-DPCL_NO_PRECOMPILE")
    
    # Generate LLVM IR
    add_custom_command(
      OUTPUT ${CMAKE_BINARY_DIR}/test/llvm/${name}.ll
      COMMAND ${CMAKE_BINARY_DIR}/compile_pcl_to_ll.sh
              ${test_src}
              ${CMAKE_BINARY_DIR}/test/llvm/${name}.ll
              "${include_dirs}"
              "${definitions}"
      DEPENDS ${test_src} ${CMAKE_BINARY_DIR}/compile_pcl_to_ll.sh
      COMMENT "Generating LLVM IR for test ${name}"
    )
    
    # Instrument the test
    add_custom_command(
      OUTPUT ${CMAKE_BINARY_DIR}/test/llvm/${name}_instrumented.ll
      COMMAND ${OPT} -load-pass-plugin="${PASS_PATH}" -passes=bb_instrument
              ${CMAKE_BINARY_DIR}/test/llvm/${name}.ll
              -o ${CMAKE_BINARY_DIR}/test/llvm/${name}_instrumented.ll 2>/dev/null || touch ${CMAKE_BINARY_DIR}/test/llvm/${name}_instrumented.ll
      DEPENDS ${CMAKE_BINARY_DIR}/test/llvm/${name}.ll
      COMMENT "Instrumenting LLVM IR for test ${name}"
    )
    
    # Get linked libraries
    get_target_property(link_libs ${name} LINK_LIBRARIES)
    set(module_bcs "")
    foreach(lib ${link_libs})
      if(lib MATCHES "^pcl_")
        string(REPLACE "pcl_" "" module ${lib})
        if(EXISTS "${CMAKE_BINARY_DIR}/llvm/${module}_instrumented.bc")
          list(APPEND module_bcs "${CMAKE_BINARY_DIR}/llvm/${module}_instrumented.bc")
        endif()
      endif()
    endforeach()
    
    # Link with PCL modules and create instrumented executable
    if(module_bcs OR test_src)
      add_custom_command(
        OUTPUT ${CMAKE_BINARY_DIR}/test/${name}_instrumented
        COMMAND ${LLVM_LINK} ${CMAKE_BINARY_DIR}/test/llvm/${name}_instrumented.ll ${module_bcs}
                -o ${CMAKE_BINARY_DIR}/test/llvm/${name}_linked.bc
        COMMAND ${CLANG} ${CMAKE_BINARY_DIR}/test/llvm/${name}_linked.bc
                -o ${CMAKE_BINARY_DIR}/test/${name}_instrumented
                -lm -lpthread 
                -L$ENV{HOME}/.local/lib -Wl,-rpath,$ENV{HOME}/.local/lib
                -L${CMAKE_BINARY_DIR}/lib -Wl,-rpath,${CMAKE_BINARY_DIR}/lib
                -lboost_system -lboost_filesystem -lboost_thread -lboost_date_time 
                -lboost_iostreams -lboost_chrono -lboost_atomic -lboost_regex
                -lgtest -lgtest_main -lstdc++ -lz
        DEPENDS ${CMAKE_BINARY_DIR}/test/llvm/${name}_instrumented.ll ${module_bcs}
        COMMENT "Building instrumented executable: ${name}_instrumented"
      )
      
      add_custom_target(${name}_instrumented_exe ALL
        DEPENDS ${CMAKE_BINARY_DIR}/test/${name}_instrumented
      )
    endif()
  endfunction()
  
  # Macro to easily add test with LLVM IR generation
  macro(PCL_ADD_TEST_WITH_LLVM_IR name)
    PCL_ADD_TEST(${name} ${ARGN})
    if(PCL_ENABLE_LLVM_IR)
      PCL_ADD_TEST_LLVM_IR(${name})
    endif()
  endmacro()
  
  # Option 3: Conditional Instrumentation
  # Save the original PCL_ADD_TEST macro before overriding it
  # We need to include the targets cmake file first to get the original macro
  include(${PCL_SOURCE_DIR}/cmake/pcl_targets.cmake)
  
  # Rename the original macro
  macro(PCL_ADD_TEST_ORIGINAL name exename)
    PCL_ADD_TEST(${name} ${exename} ${ARGN})
  endmacro()
  
  # Redefine PCL_ADD_TEST to conditionally use LLVM IR
  if(PCL_ENABLE_LLVM_IR)
    message(STATUS "Redefining PCL_ADD_TEST to automatically generate LLVM IR for all tests")
    macro(PCL_ADD_TEST name exename)
      # Parse arguments first
      set(options)
      set(oneValueArgs)
      set(multiValueArgs FILES ARGUMENTS LINK_WITH)
      cmake_parse_arguments(PCLTEST "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})
      
      # Call add_executable with the FILES argument
      add_executable(${exename} ${PCLTEST_FILES})
      if(NOT WIN32)
        set_target_properties(${exename} PROPERTIES RUNTIME_OUTPUT_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR})
      endif()
      
      target_link_libraries(${exename} ${PCLTEST_LINK_WITH} ${CLANG_LIBRARIES})
      target_link_libraries(${exename} Threads::Threads ${ATOMIC_LIBRARY})
      if(PCLTEST_ARGUMENTS)
        set_target_properties(${exename} PROPERTIES VS_DEBUGGER_COMMAND_ARGUMENTS "${PCLTEST_ARGUMENTS}")
      endif()
      add_test(NAME ${name} COMMAND ${exename} ${PCLTEST_ARGUMENTS})
      set_property(TEST ${name} APPEND PROPERTY ENVIRONMENT "LD_LIBRARY_PATH=$ENV{LD_LIBRARY_PATH}:${CMAKE_BINARY_DIR}/lib")
      
      # Automatically add LLVM IR generation
      PCL_ADD_TEST_LLVM_IR(${name})
    endmacro()
  endif()
endif()

